          "text": "LET ",
        },
        {
          "kind": "text",
          "text": "b=2",
        },
        {
          "kind": "number",
          "text": "{99}",
        },
      ],
    },
    {
      "error": "zero length line",
      "length": 0,
      "number": 60,
      "offset": 64,
      "tokens": [],
    },
  ],
  "text": "  10 PRINT "hi"
  20 LET a=1{1}
  30 PRINT     [01]
  40 REM   ① RND 
  50 LET b=2{99}
  60 ",
}
`;

