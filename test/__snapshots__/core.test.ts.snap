exports[`conversion, comparison, bits and POKEs > drops, adds, shifts, joins and flips bits 1`] = `
[
  "/8: 0 bits, flipped ",
  "  dropBits: 0 -> /8, 1 -> /8, 3 -> /8, 8 -> /8, 17 -> /8, 100 -> /8",
  "  addBits: 0 -> /8, 1 -> 00/1, 3 -> 00/3, 8 -> 00/8, 17 -> 000000/1, 100 -> 00000000000000000000000000/4",
  "  shiftLeftBits: 0 -> /8, 1 -> /8, 3 -> /8, 8 -> /8, 17 -> /8, 100 -> /8",
  "  shiftRightBits: 0 -> /8, 1 -> 00/1, 3 -> 00/3, 8 -> 00/8, 17 -> 000000/1, 100 -> 00000000000000000000000000/4",
  "b3/8: 8 bits, flipped cd",
  "  dropBits: 0 -> b3/8, 1 -> b2/7, 3 -> b0/5, 8 -> /8, 17 -> /8, 100 -> /8",
  "  addBits: 0 -> b3/8, 1 -> b300/1, 3 -> b300/3, 8 -> b300/8, 17 -> b3000000/1, 100 -> b300000000000000000000000000/4",
  "  shiftLeftBits: 0 -> b3/8, 1 -> 66/7, 3 -> 98/5, 8 -> /8, 17 -> /8, 100 -> /8",
  "  shiftRightBits: 0 -> b3/8, 1 -> 5980/1, 3 -> 1660/3, 8 -> 00b3/8, 17 -> 00005980/1, 100 -> 0000000000000000000000000b30/4",
  "b3/3: 3 bits, flipped cd",
  "  dropBits: 0 -> a0/3, 1 -> 80/2, 3 -> /8, 8 -> /8, 17 -> /8, 100 -> /8",
  "  addBits: 0 -> a0/3, 1 -> a0/4, 3 -> a0/6, 8 -> a000/3, 17 -> a00000/4, 100 -> a0000000000000000000000000/7",
  "  shiftLeftBits: 0 -> a0/3, 1 -> 40/2, 3 -> /8, 8 -> /8, 17 -> /8, 100 -> /8",
  "  shiftRightBits: 0 -> a0/3, 1 -> 50/4, 3 -> 14/6, 8 -> 00a0/3, 17 -> 000050/4, 100 -> 0000000000000000000000000a/7",
  "ff00a5/5: 21 bits, flipped ff00a5",
  "  dropBits: 0 -> ff00a0/5, 1 -> ff00a0/4, 3 -> ff0080/2, 8 -> ff00/5, 17 -> f0/4, 100 -> /8",
  "  addBits: 0 -> ff00a0/5, 1 -> ff00a0/6, 3 -> ff00a0/8, 8 -> ff00a000/5, 17 -> ff00a00000/6, 100 -> ff00a000000000000000000000000000/1",
  "  shiftLeftBits: 0 -> ff00a0/5, 1 -> fe0140/4, 3 -> f80500/2, 8 -> 00a0/5, 17 -> 40/4, 100 -> /8",
  "  shiftRightBits: 0 -> ff00a0/5, 1 -> 7f8050/6, 3 -> 1fe014/8, 8 -> 00ff00a0/5, 17 -> 00007f8050/6, 100 -> 0000000000000000000000000ff00a00/1",
  "010203040506070809/1: 65 bits, flipped 8040c020a060e01090",
  "  dropBits: 0 -> 010203040506070800/1, 1 -> 0102030405060708/8, 3 -> 0102030405060708/6, 8 -> 0102030405060700/1, 17 -> 010203040506/8, 100 -> /8",
  "  addBits: 0 -> 010203040506070800/1, 1 -> 010203040506070800/2, 3 -> 010203040506070800/4, 8 -> 01020304050607080000/1, 17 -> 0102030405060708000000/2, 100 -> 010203040506070800000000000000000000000000/5",
  "  shiftLeftBits: 0 -> 010203040506070800/1, 1 -> 020406080a0c0e10/8, 3 -> 0810182028303840/6, 8 -> 0203040506070800/1, 17 -> 06080a0c0e10/8, 100 -> /8",
  "  shiftRightBits: 0 -> 010203040506070800/1, 1 -> 008101820283038400/2, 3 -> 0020406080a0c0e100/4, 8 -> 00010203040506070800/1, 17 -> 0000008101820283038400/2, 100 -> 000000000000000000000000001020304050607080/5",
  "join /8 + b3/8 + b3/3 + ff00a5/5 + 010203040506070809/1 -> b3bfe014010203040506070800/1",
  "join b3/8 + b3/3 -> b3a0/3",
  "join b3/8 -> b3/8",
  "join /8 -> /8",
]
`;

