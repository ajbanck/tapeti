{
  "name": "tapeti",
  "version": "0.5.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "description": "ZX Spectrum TZX/TAP tape editor for the desktop and the browser",
  "scripts": {
    "dev": "npm --prefix web run dev --",
    "predev": "node scripts/build-wasm.mjs",
    "build": "npm --prefix web run build --",
    "prebuild": "node scripts/build-wasm.mjs",
    "preview": "npm --prefix web run preview --",
    "test": "npm --prefix web test --",
    "pretest": "node scripts/build-wasm.mjs",
    "typecheck": "npm --prefix web run typecheck --",
    "pretypecheck": "node scripts/build-wasm.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "headers": "node scripts/license-headers.mjs",
    "presamples": "node scripts/build-wasm.mjs",
    "samples": "node scripts/make-samples.mjs",
    "core:wasm": "node scripts/build-wasm.mjs",
    "core:test": "cd core && cargo test",
    "desktop": "node scripts/build-desktop.mjs",
    "desktop:debug": "node scripts/build-desktop.mjs --debug",
    "desktop:test": "cd desktop && cargo test",
    "desktop:package": "node scripts/build-desktop.mjs --package",
    "clean": "cargo clean",
    "core:fixtures": "cd core && UPDATE_FIXTURES=1 cargo test --test parser"
  }
}
